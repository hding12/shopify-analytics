{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BoundedMarketingInsight",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "observed_at",
    "time_window",
    "statement",
    "sources",
    "limitations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^INS-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "HYPOTHESIS",
        "OBSERVED",
        "VERIFIED",
        "INCONCLUSIVE",
        "REJECTED",
        "SUPERSEDED"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "time_window": {
      "type": "object",
      "required": [
        "start",
        "end",
        "timezone"
      ],
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        }
      }
    },
    "statement": {
      "type": "string"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "metric",
          "value",
          "unit"
        ],
        "properties": {
          "metric": {
            "type": "string"
          },
          "value": {},
          "unit": {
            "type": "string"
          },
          "denominator": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "alternative_explanations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "object"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_after": {
      "type": "string"
    },
    "visibility": {
      "enum": [
        "public",
        "internal",
        "restricted"
      ]
    }
  }
}
